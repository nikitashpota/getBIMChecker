<Window x:Class="getBIMChecker.Views.AxisManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Управление эталонными осями" 
        Height="800" 
        Width="900"
        MinHeight="800"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="White"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Revit Button Style -->
        <Style x:Key="RevitButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#D3D3D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D5D5D5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RevitApplyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFE6E6E6"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#FF5D5D5D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C9D7F1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RevitSeparator" TargetType="Separator">
            <Setter Property="Background" Value="#D3D3D3"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="RevitLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RevitSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="RevitCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D3D3D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D3D3D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Стиль для привязанной директории -->
        <Style x:Key="BoundDirectoryRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBound}" Value="True">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Background" Value="#F0F8FF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для статуса привязки -->
        <Style x:Key="BindingStatusStyle" TargetType="TextBlock" BasedOn="{StaticResource RevitLabelStyle}">
            <Setter Property="Foreground" Value="#CC0000"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBound}" Value="True">
                    <Setter Property="Foreground" Value="#008000"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.6*" MinHeight="75"/>
            <!-- Информация о модели -->
            <RowDefinition Height="5"/>
            <RowDefinition Height="0.6*" MinHeight="85"/>
            <!-- Управление директориями -->
            <RowDefinition Height="5"/>
            <RowDefinition Height="3*" MinHeight="200"/>
            <!-- Таблица директорий (ОСНОВНАЯ ВЫСОТА) -->
            <RowDefinition Height="5"/>
            <RowDefinition Height="1.2*" MinHeight="110"/>
            <!-- Управление эталонными осями -->
            <RowDefinition Height="5"/>
            <RowDefinition Height="0.8*" MinHeight="80"/>
            <!-- Проверка осей -->
        </Grid.RowDefinitions>

        <!-- Информация о модели -->
        <Border Grid.Row="0" Style="{StaticResource RevitCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Информация о модели" Style="{StaticResource RevitSectionHeaderStyle}"/>

                <Grid Grid.Row="2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Текущая модель:" Style="{StaticResource RevitLabelStyle}" Width="120"/>
                    <TextBlock Grid.Column="1" Text="{Binding ModelName}" Style="{StaticResource RevitLabelStyle}" FontWeight="SemiBold"/>

                    <TextBlock Grid.Column="3" Text="Статус привязки:" Style="{StaticResource RevitLabelStyle}" Width="120"/>
                    <TextBlock Grid.Column="4" Text="{Binding StatusMessage}" Style="{StaticResource BindingStatusStyle}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Separator -->
        <Separator Grid.Row="1" Style="{StaticResource RevitSeparator}"/>

        <!-- Управление директориями -->
        <Border Grid.Row="2" Style="{StaticResource RevitCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Управление директориями" Style="{StaticResource RevitSectionHeaderStyle}"/>

                <Button Grid.Row="2"
                        Content="Создать директорию"
                        Command="{Binding CreateDirectoryCommand}"
                        Style="{StaticResource RevitApplyButtonStyle}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Width="150"/>
            </Grid>
        </Border>

        <!-- Separator -->
        <Separator Grid.Row="3" Style="{StaticResource RevitSeparator}"/>

        <!-- Директории проектов -->
        <Border Grid.Row="4" Style="{StaticResource RevitCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="{Binding Directories.Count, StringFormat='Директории проектов ({0})', Mode=OneWay}"
                           Style="{StaticResource RevitSectionHeaderStyle}"/>

                <DataGrid Grid.Row="2" 
                          ItemsSource="{Binding Directories}" 
                          SelectedItem="{Binding SelectedDirectory, Mode=TwoWay}"
                          Style="{StaticResource DataGridStyle}"
                          RowStyle="{StaticResource BoundDirectoryRowStyle}"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код директории" 
                                            Binding="{Binding Code}" 
                                            Width="2*"/>
                        <DataGridTextColumn Header="Количество осей" 
                                            Binding="{Binding AxisCount}" 
                                            Width="*"/>
                        <DataGridTextColumn Header="Дата создания" 
                                            Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" 
                                            Width="*"/>
                        <DataGridTemplateColumn Header="Действия" Width="280">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Привязать" 
                                                Width="90" 
                                                Margin="2,0"
                                                Style="{StaticResource RevitButtonStyle}"
                                                Command="{Binding DataContext.BindDirectoryCommand, 
                                                         RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Изменить" 
                                                Width="90" 
                                                Margin="2,0"
                                                Style="{StaticResource RevitButtonStyle}"
                                                Command="{Binding DataContext.EditDirectoryCommand, 
                                                         RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Удалить" 
                                                Width="80" 
                                                Margin="2,0"
                                                Style="{StaticResource RevitButtonStyle}"
                                                Command="{Binding DataContext.DeleteDirectoryCommand, 
                                                         RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Separator -->
        <Separator Grid.Row="5" Style="{StaticResource RevitSeparator}"/>

        <!-- Управление эталонными осями -->
        <Border Grid.Row="6" Style="{StaticResource RevitCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Управление эталонными осями" Style="{StaticResource RevitSectionHeaderStyle}"/>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Шаг 1: Выбор осей -->
                    <Grid Grid.Row="0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                Content="Выбрать оси в модели"
                                Command="{Binding SelectAxisCommand}"
                                Style="{StaticResource RevitApplyButtonStyle}"
                                Width="150"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Выбрано осей: " Style="{StaticResource RevitLabelStyle}"/>
                            <TextBlock Text="{Binding SelectedAxisCount}" 
                                       Style="{StaticResource RevitLabelStyle}" 
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>

                    <!-- Шаг 2: Отправка -->
                    <Grid Grid.Row="2" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                Content="Отправить оси в БД"
                                Command="{Binding SendAxisCommand}"
                                Style="{StaticResource RevitApplyButtonStyle}"
                                Width="150"/>

                        <TextBlock Grid.Column="2"
                                   Text="Эти оси станут эталоном для всех моделей директории"
                                   Style="{StaticResource RevitLabelStyle}"
                                   Foreground="Gray"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Separator -->
        <Separator Grid.Row="7" Style="{StaticResource RevitSeparator}"/>

        <!-- Проверка осей модели -->
        <Border Grid.Row="8" Style="{StaticResource RevitCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Проверка осей модели" Style="{StaticResource RevitSectionHeaderStyle}"/>

                <Grid Grid.Row="2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Проверка осей"
                            Command="{Binding RunAxisCheckCommand}"
                            Style="{StaticResource RevitApplyButtonStyle}"
                            Width="150"/>

                    <TextBlock Grid.Column="2"
                               Text="Сравнивает оси текущей модели с эталонными осями директории"
                               Style="{StaticResource RevitLabelStyle}"
                               Foreground="Gray"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
