<Window x:Class="getBIMChecker.Views.LevelCheckResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:getBIMChecker.Converters"
        Title="Результаты проверки уровней" 
        Height="700" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Window.Resources>
        <local:LevelErrorTypesConverter x:Key="LevelErrorTypesConverter"/>
        <local:LevelDeviationConverter x:Key="LevelDeviationConverter"/>
        <local:LevelPinnedConverter x:Key="LevelPinnedConverter"/>

        <Style x:Key="RevitButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#D3D3D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="RevitApplyButtonStyle" TargetType="Button" BasedOn="{StaticResource RevitButtonStyle}">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="10,2"/>
        </Style>

        <Style x:Key="RevitCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D3D3D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="RevitLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RevitSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D3D3D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="RevitSeparator" TargetType="Separator">
            <Setter Property="Background" Value="#D3D3D3"/>
            <Setter Property="Height" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Информация о проверке -->
        <Border Grid.Row="0" Style="{StaticResource RevitCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Информация о проверке" Style="{StaticResource RevitSectionHeaderStyle}"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Модель:" Style="{StaticResource RevitLabelStyle}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding Report.ModelName}" Style="{StaticResource RevitLabelStyle}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Директория:" Style="{StaticResource RevitLabelStyle}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding Report.DirectoryCode}" Style="{StaticResource RevitLabelStyle}"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Дата проверки:" Style="{StaticResource RevitLabelStyle}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding Report.CheckDate, StringFormat='dd.MM.yyyy HH:mm'}" Style="{StaticResource RevitLabelStyle}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Уровней в модели:" Style="{StaticResource RevitLabelStyle}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding Report.TotalLevelsInModel}" Style="{StaticResource RevitLabelStyle}"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Эталонных уровней:" Style="{StaticResource RevitLabelStyle}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding Report.TotalReferenceLevels}" Style="{StaticResource RevitLabelStyle}"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Уровней с ошибками:" Style="{StaticResource RevitLabelStyle}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding Errors.Count}" Style="{StaticResource RevitLabelStyle}" Foreground="#CC0000" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Separator Grid.Row="1" Style="{StaticResource RevitSeparator}"/>

        <!-- Панель действий -->
        <Border Grid.Row="2" Style="{StaticResource RevitCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Исправить все ошибки" Command="{Binding FixAllCommand}" Width="180" Style="{StaticResource RevitApplyButtonStyle}"/>
                    <TextBlock Text="Ошибки 'Отсутствует в эталоне' требуют ручного решения"
                               Style="{StaticResource RevitLabelStyle}" Foreground="Gray" FontStyle="Italic" Margin="15,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding ErrorStatistics}" Style="{StaticResource RevitLabelStyle}" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Separator Grid.Row="3" Style="{StaticResource RevitSeparator}"/>

        <!-- Таблица ошибок -->
        <Border Grid.Row="4" Style="{StaticResource RevitCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding Errors.Count, StringFormat='Найденные ошибки ({0})'}" Style="{StaticResource RevitSectionHeaderStyle}"/>
                    <TextBlock Text=" — выберите строку для выделения уровня в модели" Style="{StaticResource RevitLabelStyle}" Foreground="Gray" FontStyle="Italic" Margin="10,0,0,0"/>
                </StackPanel>

                <DataGrid Grid.Row="2" ItemsSource="{Binding Errors}" SelectedItem="{Binding SelectedError, Mode=TwoWay}" Style="{StaticResource DataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Действие" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Исправить" Command="{Binding DataContext.FixSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="ElementId" Binding="{Binding ElementId}" Width="90"/>
                        <DataGridTextColumn Header="Имя уровня" Binding="{Binding LevelName}" Width="120"/>
                        <DataGridTextColumn Header="Тип ошибки" Binding="{Binding Path=., Converter={StaticResource LevelErrorTypesConverter}}" Width="250"/>
                        <DataGridTextColumn Header="Отклонение (мм)" Binding="{Binding Path=., Converter={StaticResource LevelDeviationConverter}}" Width="110"/>
                        <DataGridTextColumn Header="Закреплен" Binding="{Binding Path=., Converter={StaticResource LevelPinnedConverter}}" Width="80"/>
                        <DataGridTextColumn Header="Рабочий набор" Binding="{Binding WorksetName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Separator Grid.Row="5" Style="{StaticResource RevitSeparator}"/>

        <!-- Кнопки -->
        <Border Grid.Row="6" Style="{StaticResource RevitCardStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Обновить список" Command="{Binding RefreshCommand}" Style="{StaticResource RevitApplyButtonStyle}" Width="120" Margin="0,0,10,0"/>
                <Button Content="Экспорт в CSV" Command="{Binding ExportToCsvCommand}" Style="{StaticResource RevitApplyButtonStyle}" Width="120" Margin="0,0,10,0"/>
                <Button Content="Закрыть" Command="{Binding CloseCommand}" Style="{StaticResource RevitApplyButtonStyle}" Width="80"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>