<Window x:Class="getBIMChecker.Views.CheckResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:getBIMChecker.Converters"
        Title="Результаты проверки осей" 
        Height="750" Width="1200"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="White"
        Topmost="False">

    <Window.Resources>
        <!-- Конвертеры -->
        <local:ErrorTypesConverter x:Key="ErrorTypesConverter"/>
        <local:DeviationConverter x:Key="DeviationConverter"/>
        <local:PinnedConverter x:Key="PinnedConverter"/>
        <local:CanFixConverter x:Key="CanFixConverter"/>

        <!-- Стили -->
        <Style x:Key="RevitButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#D3D3D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D5D5D5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RevitApplyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFE6E6E6"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#FF5D5D5D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C9D7F1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FixButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E8F5E9"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
            <Setter Property="BorderBrush" Value="#A5D6A7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C8E6C9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FixAllButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#388E3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#43A047"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#A5D6A7"/>
                                <Setter Property="BorderBrush" Value="#C8E6C9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RevitSeparator" TargetType="Separator">
            <Setter Property="Background" Value="#D3D3D3"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="RevitLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RevitSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="RevitCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D3D3D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D3D3D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="StatusBarStyle" TargetType="Border">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="130"/>
                <!-- Информация о проверке -->
                <RowDefinition Height="5"/>
                <RowDefinition Height="Auto"/>
                <!-- Панель действий -->
                <RowDefinition Height="5"/>
                <RowDefinition Height="*" MinHeight="250"/>
                <!-- Таблица ошибок -->
                <RowDefinition Height="5"/>
                <RowDefinition Height="Auto"/>
                <!-- Кнопки -->
            </Grid.RowDefinitions>

            <!-- Информация о проверке -->
            <Border Grid.Row="0" Style="{StaticResource RevitCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Информация о проверке" Style="{StaticResource RevitSectionHeaderStyle}"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Левая колонка -->
                        <StackPanel Grid.Column="0">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Модель:" Style="{StaticResource RevitLabelStyle}" FontWeight="SemiBold" Width="150"/>
                                <TextBlock Grid.Column="1" Text="{Binding Report.ModelName}" Style="{StaticResource RevitLabelStyle}" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Директория:" Style="{StaticResource RevitLabelStyle}" FontWeight="SemiBold" Width="150"/>
                                <TextBlock Grid.Column="1" Text="{Binding Report.DirectoryCode}" Style="{StaticResource RevitLabelStyle}"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Дата проверки:" Style="{StaticResource RevitLabelStyle}" FontWeight="SemiBold" Width="150"/>
                                <TextBlock Grid.Column="1" Text="{Binding Report.CheckDate, StringFormat='dd.MM.yyyy HH:mm'}" Style="{StaticResource RevitLabelStyle}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Правая колонка -->
                        <StackPanel Grid.Column="2">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Всего осей в модели:" Style="{StaticResource RevitLabelStyle}" FontWeight="SemiBold" Width="180"/>
                                <TextBlock Grid.Column="1" Text="{Binding Report.TotalAxesInModel}" Style="{StaticResource RevitLabelStyle}"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Всего эталонных осей:" Style="{StaticResource RevitLabelStyle}" FontWeight="SemiBold" Width="180"/>
                                <TextBlock Grid.Column="1" Text="{Binding Report.TotalReferenceAxes}" Style="{StaticResource RevitLabelStyle}"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Осей с ошибками:" Style="{StaticResource RevitLabelStyle}" FontWeight="SemiBold" Width="180"/>
                                <TextBlock Grid.Column="1" Text="{Binding Errors.Count}" Style="{StaticResource RevitLabelStyle}" Foreground="#CC0000" FontWeight="Bold"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Separator -->
            <Separator Grid.Row="1" Style="{StaticResource RevitSeparator}"/>

            <!-- Панель действий -->
            <Border Grid.Row="2" Style="{StaticResource RevitCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Кнопка исправить все -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="🔧 Исправить все ошибки" 
                                Command="{Binding FixAllCommand}"
                                Style="{StaticResource FixAllButtonStyle}"
                                Width="180"
                                ToolTip="Автоматически исправить все ошибки, которые можно исправить"/>

                        <TextBlock Text="Ошибки 'Отсутствует в эталоне' требуют ручного решения"
                                   Style="{StaticResource RevitLabelStyle}"
                                   Foreground="Gray"
                                   FontStyle="Italic"
                                   Margin="15,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Статистика ошибок -->
                    <TextBlock Grid.Column="2" 
                               Text="{Binding ErrorStatistics}" 
                               Style="{StaticResource RevitLabelStyle}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Separator -->
            <Separator Grid.Row="3" Style="{StaticResource RevitSeparator}"/>

            <!-- Таблица ошибок -->
            <Border Grid.Row="4" Style="{StaticResource RevitCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="{Binding Errors.Count, StringFormat='Найденные ошибки ({0})', Mode=OneWay}"
                                   Style="{StaticResource RevitSectionHeaderStyle}"/>
                        <TextBlock Text=" — выберите строку для выделения оси в модели"
                                   Style="{StaticResource RevitLabelStyle}"
                                   Foreground="Gray"
                                   FontStyle="Italic"
                                   Margin="10,0,0,0"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" 
                              ItemsSource="{Binding Errors}"
                              SelectedItem="{Binding SelectedError, Mode=TwoWay}"
                              Style="{StaticResource DataGridStyle}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <!-- Кнопка исправить -->
                            <DataGridTemplateColumn Header="Действие" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Исправить" 
                                                Style="{StaticResource FixButtonStyle}"
                                                Command="{Binding DataContext.FixSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                IsEnabled="{Binding Path=., Converter={StaticResource CanFixConverter}}"
                                                ToolTip="Исправить эту ось"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="ElementId" 
                                                Binding="{Binding ElementId}" 
                                                Width="90"/>
                            <DataGridTextColumn Header="Имя оси" 
                                                Binding="{Binding AxisName}" 
                                                Width="90"/>
                            <DataGridTextColumn Header="Тип ошибки" 
                                                Binding="{Binding Path=., Converter={StaticResource ErrorTypesConverter}}" 
                                                Width="280"/>
                            <DataGridTextColumn Header="Смещение (мм)" 
                                                Binding="{Binding Path=., Converter={StaticResource DeviationConverter}}" 
                                                Width="110"/>
                            <DataGridTextColumn Header="Закреплена" 
                                                Binding="{Binding Path=., Converter={StaticResource PinnedConverter}}" 
                                                Width="90"/>
                            <DataGridTextColumn Header="Рабочий набор" 
                                                Binding="{Binding WorksetName}" 
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Separator -->
            <Separator Grid.Row="5" Style="{StaticResource RevitSeparator}"/>

            <!-- Кнопки -->
            <Border Grid.Row="6" Style="{StaticResource RevitCardStyle}">
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="Обновить список" 
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource RevitApplyButtonStyle}"
                            Width="120" 
                            Margin="0,0,10,0"
                            ToolTip="Обновить список ошибок (удалить исправленные)"/>
                    <Button Content="Экспорт в CSV" 
                            Command="{Binding ExportToCsvCommand}"
                            Style="{StaticResource RevitApplyButtonStyle}"
                            Width="120" 
                            Margin="0,0,10,0"/>
                    <Button Content="Закрыть" 
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource RevitApplyButtonStyle}"
                            Width="80"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
